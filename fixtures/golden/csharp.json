{
  "includeRoot": "fixtures/include/csharp",
  "cases": [
    {
      "name": "expression",
      "code": "1 + 2",
      "expect": {
        "success": true,
        "value": "3"
      }
    },
    {
      "name": "statements-then-expression",
      "code": "var x = 21;\nx * 2",
      "expect": {
        "success": true,
        "value": "42"
      }
    },
    {
      "name": "expression-with-semicolon",
      "code": "var x = 21;\nx * 2;",
      "expect": {
        "success": true,
        "value": "42"
      }
    },
    {
      "name": "own-using",
      "code": "using System.Text;\nvar sb = new StringBuilder(\"ab\");\nsb.Append('c');\nsb.ToString()",
      "expect": {
        "success": true,
        "value": "abc"
      }
    },
    {
      "name": "alias-using",
      "code": "using SB = System.Text.StringBuilder;\nnew SB(\"z\").ToString()",
      "expect": {
        "success": true,
        "value": "z"
      }
    },
    {
      "name": "static-using",
      "code": "using static System.Math;\nMax(3, 9)",
      "expect": {
        "success": true,
        "value": "9"
      }
    },
    {
      "name": "request-usings",
      "code": "new StringBuilder(\"r\").ToString()",
      "usings": [
        "System.Text"
      ],
      "expect": {
        "success": true,
        "value": "r",
        "autoImported": []
      }
    },
    {
      "name": "local-class",
      "code": "class P { public int X; }\nnew P { X = 5 }.X",
      "expect": {
        "success": true,
        "value": "5"
      }
    },
    {
      "name": "local-method",
      "code": "int Twice(int n) => n * 2;\nTwice(4)",
      "expect": {
        "success": true,
        "value": "8"
      }
    },
    {
      "name": "local-function-sees-locals",
      "code": "int n = 0;\nvoid Inc() => n++;\nInc();\nInc();\nn",
      "expect": {
        "success": true,
        "value": "2"
      }
    },
    {
      "name": "local-function-declared-after-use",
      "code": "Twice(5)\nint Twice(int v) => v * 2;",
      "expect": {
        "success": true,
        "value": "10"
      }
    },
    {
      "name": "void-call-with-locals",
      "code": "var list = new List<int>();\nlist.Add(1)",
      "expect": {
        "success": true,
        "value": null
      }
    },
    {
      "name": "static-field-keeps-modifier",
      "code": "static int counter = 3;\ncounter + 1",
      "expect": {
        "success": true,
        "value": "4"
      }
    },
    {
      "name": "bare-return",
      "code": "if (DateTime.Now.Year > 2000) return;\nreturn 1;",
      "expect": {
        "success": true,
        "value": null
      }
    },
    {
      "name": "void-last-call",
      "code": "Console.Write(\"\")",
      "expect": {
        "success": true,
        "value": null
      }
    },
    {
      "name": "no-result",
      "code": "var unused = 1;",
      "expect": {
        "success": true,
        "value": null
      }
    },
    {
      "name": "explicit-return",
      "code": "var list = new List<int> { 3, 1, 2 };\nreturn list.OrderBy(i => i).First();",
      "expect": {
        "success": true,
        "value": "1"
      }
    },
    {
      "name": "lambda-return-untouched",
      "code": "Func<int> f = () => { return 7; };\nf()",
      "expect": {
        "success": true,
        "value": "7"
      }
    },
    {
      "name": "await",
      "code": "var v = await System.Threading.Tasks.Task.FromResult(5);\nv + 1",
      "expect": {
        "success": true,
        "value": "6"
      }
    },
    {
      "name": "await-delay",
      "code": "await System.Threading.Tasks.Task.Delay(20);\n\"done\"",
      "expect": {
        "success": true,
        "value": "done"
      }
    },
    {
      "name": "logs",
      "code": "Console.WriteLine(\"hello\");\n1",
      "expect": {
        "success": true,
        "value": "1",
        "logsContain": [
          "hello"
        ]
      }
    },
    {
      "name": "auto-import",
      "code": "new StringBuilder(\"q\").Append(1).ToString()",
      "expect": {
        "success": true,
        "value": "q1",
        "autoImported": [
          "System.Text"
        ]
      }
    },
    {
      "name": "compile-error-line",
      "code": "var a = 1;\nvar b = undefinedThing;",
      "expect": {
        "success": false,
        "errorKind": "Compile",
        "diagnostic": {
          "file": "snippet.cs",
          "line": 2
        }
      }
    },
    {
      "name": "compile-error-line-after-using",
      "code": "using System.Text;\n\nvar a = 1;\nint b = \"x\";",
      "expect": {
        "success": false,
        "errorKind": "Compile",
        "diagnostic": {
          "file": "snippet.cs",
          "line": 4
        }
      }
    },
    {
      "name": "runtime-exception",
      "code": "throw new InvalidOperationException(\"boom\");",
      "expect": {
        "success": false,
        "errorKind": "Runtime",
        "errorContains": "boom"
      }
    },
    {
      "name": "include-folder-recursive",
      "code": "AgentHelpers.Cube.Of(3) + AgentHelpers.Geo.Sq(2)",
      "include": [
        "geo"
      ],
      "expect": {
        "success": true,
        "value": "31"
      }
    },
    {
      "name": "include-error-path",
      "code": "AgentHelpers.Broken.X",
      "include": [
        "Broken.cs"
      ],
      "expect": {
        "success": false,
        "errorKind": "Compile",
        "diagnostic": {
          "file": "Broken.cs",
          "line": 1
        }
      }
    },
    {
      "name": "include-missing",
      "code": "1",
      "include": [
        "missing.cs"
      ],
      "expect": {
        "success": false,
        "errorKind": "InvalidRequest"
      }
    },
    {
      "name": "empty-code",
      "code": "  ",
      "expect": {
        "success": false,
        "errorKind": "InvalidRequest"
      }
    },
    {
      "name": "full-source",
      "code": "public static class Entry { public static object Run() { return 7; } }",
      "entry": {
        "type": "Entry",
        "method": "Run"
      },
      "expect": {
        "success": true,
        "value": "7"
      }
    },
    {
      "name": "full-source-namespaced",
      "code": "namespace N { public static class Entry { public static int Run() => 8; } }",
      "entry": {
        "type": "N.Entry",
        "method": "Run"
      },
      "expect": {
        "success": true,
        "value": "8"
      }
    },
    {
      "name": "full-source-missing-entry",
      "code": "public static class Entry { public static int Run() => 8; }",
      "entry": {
        "type": "Entry",
        "method": "Nope"
      },
      "expect": {
        "success": false,
        "errorKind": "EntryPointNotFound"
      }
    }
  ]
}
