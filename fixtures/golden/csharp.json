{
  "includeRoot": "fixtures/include/csharp",
  "cases": [
    {
      "name": "expression",
      "code": "1 + 2",
      "expect": {
        "success": true,
        "value": "3",
        "returnType": "System.Int32"
      }
    },
    {
      "name": "result-type-generic",
      "code": "new List<int> { 1, 2 }",
      "expect": {
        "success": true,
        "returnType": "System.Collections.Generic.List<System.Int32>"
      }
    },
    {
      "name": "result-type-tuple-is-object",
      "code": "(1, \"a\")",
      "expect": {
        "success": true,
        "returnType": "System.Object"
      }
    },
    {
      "name": "statements-then-expression",
      "code": "var x = 21;\nx * 2",
      "expect": {
        "success": true,
        "value": "42"
      }
    },
    {
      "name": "expression-with-semicolon",
      "code": "var x = 21;\nx * 2;",
      "expect": {
        "success": true,
        "value": "42"
      }
    },
    {
      "name": "own-using",
      "code": "using System.Text;\nvar sb = new StringBuilder(\"ab\");\nsb.Append('c');\nsb.ToString()",
      "expect": {
        "success": true,
        "value": "abc"
      }
    },
    {
      "name": "alias-using",
      "code": "using SB = System.Text.StringBuilder;\nnew SB(\"z\").ToString()",
      "expect": {
        "success": true,
        "value": "z"
      }
    },
    {
      "name": "static-using",
      "code": "using static System.Math;\nMax(3, 9)",
      "expect": {
        "success": true,
        "value": "9"
      }
    },
    {
      "name": "request-usings",
      "code": "new StringBuilder(\"r\").ToString()",
      "usings": [
        "System.Text"
      ],
      "expect": {
        "success": true,
        "value": "r",
        "autoImported": []
      }
    },
    {
      "name": "local-class",
      "code": "class P { public int X; }\nnew P { X = 5 }.X",
      "expect": {
        "success": true,
        "value": "5"
      }
    },
    {
      "name": "local-method",
      "code": "int Twice(int n) => n * 2;\nTwice(4)",
      "expect": {
        "success": true,
        "value": "8"
      }
    },
    {
      "name": "local-function-sees-locals",
      "code": "int n = 0;\nvoid Inc() => n++;\nInc();\nInc();\nn",
      "expect": {
        "success": true,
        "value": "2"
      }
    },
    {
      "name": "local-function-declared-after-use",
      "code": "Twice(5)\nint Twice(int v) => v * 2;",
      "expect": {
        "success": true,
        "value": "10"
      }
    },
    {
      "name": "void-call-with-locals",
      "code": "var list = new List<int>();\nlist.Add(1)",
      "expect": {
        "success": true,
        "value": null,
        "returnType": "System.Void"
      }
    },
    {
      "name": "static-field-keeps-modifier",
      "code": "static int counter = 3;\ncounter + 1",
      "expect": {
        "success": true,
        "value": "4"
      }
    },
    {
      "name": "attributed-member-becomes-static",
      "code": "[System.Diagnostics.DebuggerStepThrough] int F() => 6;\nF()",
      "expect": {
        "success": true,
        "value": "6"
      }
    },
    {
      "name": "bare-return",
      "code": "if (DateTime.Now.Year > 2000) return;\nreturn 1;",
      "expect": {
        "success": true,
        "value": null,
        "returnType": "System.Object"
      }
    },
    {
      "name": "tail-with-bare-return",
      "code": "if (DateTime.Now.Year < 2000) return;\n1 + 2",
      "expect": {
        "success": true,
        "value": "3",
        "returnType": "System.Object"
      }
    },
    {
      "name": "void-with-bare-return",
      "code": "if (DateTime.Now.Year > 2000) return;\nConsole.Write(\"\");",
      "expect": {
        "success": true,
        "value": null,
        "returnType": "System.Void"
      }
    },
    {
      "name": "async-void",
      "code": "await Task.Delay(1);\nConsole.Write(\"\");",
      "expect": {
        "success": true,
        "value": null,
        "returnType": "System.Void"
      }
    },
    {
      "name": "void-last-call",
      "code": "Console.Write(\"\")",
      "expect": {
        "success": true,
        "value": null,
        "returnType": "System.Void"
      }
    },
    {
      "name": "no-result",
      "code": "var unused = 1;",
      "expect": {
        "success": true,
        "value": null,
        "returnType": "System.Void"
      }
    },
    {
      "name": "explicit-return",
      "code": "var list = new List<int> { 3, 1, 2 };\nreturn list.OrderBy(i => i).First();",
      "expect": {
        "success": true,
        "value": "1"
      }
    },
    {
      "name": "lambda-return-untouched",
      "code": "Func<int> f = () => { return 7; };\nf()",
      "expect": {
        "success": true,
        "value": "7"
      }
    },
    {
      "name": "await",
      "code": "var v = await System.Threading.Tasks.Task.FromResult(5);\nv + 1",
      "expect": {
        "success": true,
        "value": "6",
        "returnType": "System.Int32"
      }
    },
    {
      "name": "await-delay",
      "code": "await System.Threading.Tasks.Task.Delay(20);\n\"done\"",
      "expect": {
        "success": true,
        "value": "done"
      }
    },
    {
      "name": "logs",
      "code": "Console.WriteLine(\"hello\");\n1",
      "expect": {
        "success": true,
        "value": "1",
        "logsContain": [
          "hello"
        ]
      }
    },
    {
      "name": "auto-import",
      "code": "new StringBuilder(\"q\").Append(1).ToString()",
      "expect": {
        "success": true,
        "value": "q1",
        "autoImported": [
          "System.Text"
        ]
      }
    },
    {
      "name": "compile-error-line",
      "code": "var a = 1;\nvar b = undefinedThing;",
      "expect": {
        "success": false,
        "errorKind": "Compile",
        "diagnostic": {
          "file": "snippet.cs",
          "line": 2
        }
      }
    },
    {
      "name": "compile-error-line-after-using",
      "code": "using System.Text;\n\nvar a = 1;\nint b = \"x\";",
      "expect": {
        "success": false,
        "errorKind": "Compile",
        "diagnostic": {
          "file": "snippet.cs",
          "line": 4
        }
      }
    },
    {
      "name": "runtime-exception",
      "code": "throw new InvalidOperationException(\"boom\");",
      "expect": {
        "success": false,
        "errorKind": "Runtime",
        "errorContains": "boom"
      }
    },
    {
      "name": "include-folder-recursive",
      "code": "AgentHelpers.Cube.Of(3) + AgentHelpers.Geo.Sq(2)",
      "include": [
        "geo"
      ],
      "expect": {
        "success": true,
        "value": "31"
      }
    },
    {
      "name": "include-error-path",
      "code": "AgentHelpers.Broken.X",
      "include": [
        "Broken.cs"
      ],
      "expect": {
        "success": false,
        "errorKind": "Compile",
        "diagnostic": {
          "file": "Broken.cs",
          "line": 1
        }
      }
    },
    {
      "name": "include-missing",
      "code": "1",
      "include": [
        "missing.cs"
      ],
      "expect": {
        "success": false,
        "errorKind": "InvalidRequest"
      }
    },
    {
      "name": "empty-code",
      "code": "  ",
      "expect": {
        "success": false,
        "errorKind": "InvalidRequest"
      }
    },
    {
      "name": "full-source",
      "code": "public static class Entry { public static object Run() { return 7; } }",
      "entry": {
        "type": "Entry",
        "method": "Run"
      },
      "expect": {
        "success": true,
        "value": "7"
      }
    },
    {
      "name": "full-source-task-result",
      "code": "public static class Entry { public static async System.Threading.Tasks.Task<int> Run() { await System.Threading.Tasks.Task.Yield(); return 9; } }",
      "entry": {
        "type": "Entry",
        "method": "Run"
      },
      "expect": {
        "success": true,
        "value": "9",
        "returnType": "System.Int32"
      }
    },
    {
      "name": "full-source-namespaced",
      "code": "namespace N { public static class Entry { public static int Run() => 8; } }",
      "entry": {
        "type": "N.Entry",
        "method": "Run"
      },
      "expect": {
        "success": true,
        "value": "8",
        "returnType": "System.Int32"
      }
    },
    {
      "name": "full-source-missing-entry",
      "code": "public static class Entry { public static int Run() => 8; }",
      "entry": {
        "type": "Entry",
        "method": "Nope"
      },
      "expect": {
        "success": false,
        "errorKind": "EntryPointNotFound"
      }
    },
    {
      "name": "value-clipped",
      "code": "new string('x', 30)",
      "maxValueChars": 10,
      "expect": {
        "success": true,
        "value": "xxxxxxxxxx... [truncated: 10 of 30 characters shown; return a slice or a summary]",
        "truncated": [
          "value"
        ]
      }
    },
    {
      "name": "value-default-limit",
      "code": "new string('x', 30000)",
      "expect": {
        "success": true,
        "valueEndsWith": "xx... [truncated: 20000 of 30000 characters shown; return a slice or a summary]",
        "truncated": [
          "value"
        ]
      }
    },
    {
      "name": "value-no-limit",
      "code": "new string('x', 30000)",
      "maxValueChars": 0,
      "expect": {
        "success": true,
        "valueLength": 30000,
        "truncated": []
      }
    },
    {
      "name": "logs-first-and-last",
      "code": "for (var i = 0; i < 10; i++) Console.WriteLine($\"line {i}\");",
      "maxLogChars": 60,
      "expect": {
        "success": true,
        "logs": [
          "line 0",
          "line 1",
          "... 7 log line(s) left out (output over 60 characters): print less, or return a summary",
          "line 9"
        ],
        "truncated": [
          "logs"
        ]
      }
    },
    {
      "name": "log-line-clipped",
      "code": "Console.WriteLine(new string('y', 50));",
      "maxLogLineChars": 5,
      "expect": {
        "success": true,
        "logs": [
          "yyyyy... [truncated: 5 of 50 characters shown; print less]"
        ],
        "truncated": [
          "logs"
        ]
      }
    },
    {
      "name": "logs-within-budget",
      "code": "Console.WriteLine(\"a\");\nConsole.WriteLine(\"b\");",
      "maxLogChars": 26,
      "expect": {
        "success": true,
        "logs": [
          "a",
          "b"
        ],
        "truncated": []
      }
    },
    {
      "name": "error-clipped",
      "code": "throw new InvalidOperationException(new string('z', 100));",
      "maxErrorChars": 20,
      "expect": {
        "success": false,
        "errorKind": "Runtime",
        "errorContains": "... [truncated: 20 of ",
        "truncated": [
          "error"
        ]
      }
    },
    {
      "name": "limit-negative",
      "code": "1",
      "maxValueChars": -1,
      "expect": {
        "success": false,
        "errorKind": "InvalidRequest"
      }
    },
    {
      "name": "deep-traceback",
      "code": "int R(int n) => n == 0 ? throw new InvalidOperationException(\"deep\") : R(n - 1);\nR(50)",
      "expect": {
        "success": false,
        "errorKind": "Runtime",
        "errorContains": "32 frame(s) left out"
      }
    },
    {
      "name": "exception-message-unprintable",
      "code": "class E : Exception { public override string Message => throw new InvalidOperationException(); }\nthrow new E();",
      "expect": {
        "success": false,
        "errorKind": "Runtime",
        "errorContains": "<unprintable message>"
      }
    },
    {
      "name": "include-outside-root",
      "code": "1",
      "include": [
        "../outside/helper"
      ],
      "expect": {
        "success": false,
        "errorKind": "InvalidRequest",
        "errorContains": "outside the include root"
      }
    },
    {
      "name": "include-wrong-extension",
      "code": "1",
      "include": [
        "notes.txt"
      ],
      "expect": {
        "success": false,
        "errorKind": "InvalidRequest",
        "errorContains": "include is not a ."
      }
    },
    {
      "name": "inner-exception",
      "code": "throw new Exception(\"outer\", new ArgumentException(\"inner cause\"));",
      "expect": {
        "success": false,
        "errorKind": "Runtime",
        "errorContains": " ---> System.ArgumentException: inner cause"
      }
    },
    {
      "name": "bad-using",
      "code": "1",
      "usings": [
        "No.Such.Namespace"
      ],
      "expect": {
        "success": false,
        "errorKind": "Compile",
        "diagnostic": {
          "file": "usings",
          "line": 0
        }
      }
    }
  ]
}
