<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compiles Core AND the adapter as SOURCE in one assembly, the way a vendoring host does (Unity copies both into an
    Editor assembly): netstandard2.0, C# 9, nullable OFF (a file missing `#nullable enable` fails with CS8632), warnings
    as errors (Directory.Build.props). Build-only check; -p:RoslynVersion=... picks the Roslyn line (default Unity's 4.8).
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RoslynVersion Condition="'$(RoslynVersion)' == ''">4.8.0</RoslynVersion>
    <NoWarn>$(NoWarn);NU1902;NU1903;NU1608</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../CodeExec/**/*.cs;../../CodeExec.Roslyn/src/**/*.cs" Exclude="../../CodeExec/bin/**;../../CodeExec/obj/**" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(RoslynVersion)" />
  </ItemGroup>
</Project>
