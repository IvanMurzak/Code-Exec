<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
    <Version>0.2.1</Version>
    <Authors>Ivan Murzak</Authors>
    <Copyright>Copyright (c) 2026 Ivan Murzak</Copyright>
    <RepositoryUrl>https://github.com/IvanMurzak/Code-Exec</RepositoryUrl>
    <PackageProjectUrl>https://github.com/IvanMurzak/Code-Exec</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <!-- Only CodeExec and CodeExec.Roslyn are packed; nothing else opts in. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
